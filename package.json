{
  "name": "nest-three-project",
  "version": "1.0.0",
  "description": "3D Web Application with NestJS and Three.js",
  "scripts": {
    "start": "node dist/server/main.js",
    "build": "tsc -p server/tsconfig.server.json && vite build client",
    "dev": "concurrently \"tsc -w -p server/tsconfig.server.json\" \"vite client\""
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/serve-static": "^4.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.0.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/three": "^0.160.0",
    "concurrently": "^8.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
